{
	"name": "pep-mkp-common-offering",
	"version": "0.0.1",
	"private": true,
	"main": "./dist/server/entry-server.js",
	"exports": {
		".": "./dist/server/entry-server.js",
		"./client": "./dist/client/entry-client.js",
		"./server": "./dist/server/entry-server.js",
		"./data": "./dist/data/data.es.js"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:client && npm run build:server",
		"build:client": "vite build --mode=production --config vite.config.ts --outDir dist/client",
		"build:server": "vite build --mode=server --config vite.config.ts --outDir dist/server",
		"build:data": "[ -f src/server.ts ] && vite build --mode=data --config vite.config.ts --outDir dist/data || echo 'Skipping data build: src/component.server.ts not found'",
		"build:editor": "vite build --mode=editor --config vite.config.ts --outDir dist/editor",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"@pep/config": "workspace:*",
		"@pep/bff": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tslib": "^2.0.0",
		"typescript": "^5.0.0",
		"vite": "^5.0.0",
		"express": "^4.18.0"
	},
	"type": "module"
}