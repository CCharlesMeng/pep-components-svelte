{
    "title": "楼层信息",
    "type": "object",
    "properties": {
        "baseInfo": {
            "type": "object",
            "properties": {
                "bg": {
                    "title": "导航样式",
                    "type": "string",
                    "ui:options": {
                        "theme": "button"
                    },
                    "enum": [
                        "white",
                        "bluegrey",
                        "halftransparent",
                        "shallowgrey"
                    ],
                    "enumNames": [
                        "白色黑字",
                        "蓝灰色黑字",
                        "半透明黑字",
                        "灰色黑字"
                    ],
                    "default": "white"
                },
                "isShowKeyWord": {
                    "title": "是否展示页面关键词",
                    "type": "boolean",
                    "ui:widget": "switch",
                    "default": false
                },
                "isFixed": {
                    "type": "boolean",
                    "title": "是否吸顶",
                    "ui:widget": "switch",
                    "default": true
                },
                "top": {
                    "title": "向上间距",
                    "type": "number",
                    "default": "0"
                },
                "bottom": {
                    "title": "向下间距",
                    "type": "number",
                    "default": "0"
                }
            }
        },
        "tabs": {
            "title": "配置页签信息",
            "type": "array",
            "ui:widget": "tab",
            "ui:options": {
                "tabTitle": "tabTitle",
                "min": 1,
                "max": 10
            },
            "default": [],
            "items": {
                "type": "object",
                "properties": {
                    "tabTitle": {
                        "title": "页签标题",
                        "type": "string"
                    },
                    "tabUrl": {
                        "title": "页签链接",
                        "type": "string"
                    },
                    "tabContent": {
                        "type": "object",
                        "ui:ptions": {
                            "hidden": "child-component"
                        },
                        "properties": {
                            "isShowSelect": {
                                "title": "显示下拉菜单",
                                "type": "boolean",
                                "ui:widget": "switch",
                                "description": "开启后可配置下拉菜单内容，请在页面中单独配置",
                                "default": false
                            },
                            "recommendType": {
                                "title": "推荐方式",
                                "type": "string",
                                "ui:widget": "radio",
                                "ui:options": {
                                    "hidden": "!rootValue.isShowSelect",
                                    "options": [
                                        {
                                            "value": "1",
                                            "label": "人工编辑"
                                        },
                                        {
                                            "value": "2",
                                            "label": "搜索聚合"
                                        }
                                    ]
                                }
                            },
                            "items": {
                                "type": "array",
                                "title": "文章列表",
                                "ui:options": {
                                    "min": 1,
                                    "hidden": "rootValue.recommendType !== '1' || !rootValue.isShowSelect"
                                },
                                "items": {
                                    "type": "object",
                                    "title": "文章",
                                    "properties": {
                                        "title": {
                                            "title": "菜单名称",
                                            "type": "string"
                                        },
                                        "url": {
                                            "title": "菜单链接",
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "article": {
                                "type": "object",
                                "ui:options": {
                                    "hidden": "rootValue.recommendType === '1' || !rootValue.isShowSelect"
                                },
                                "properties": {
                                    "source": {
                                        "title": "文章来源",
                                        "type": "string",
                                        "ui:widget": "radio",
                                        "ui:options": {
                                            "options": [
                                                {
                                                    "value": "1",
                                                    "label": "全网文章"
                                                },
                                                {
                                                    "value": "3",
                                                    "label": "用户手册"
                                                }
                                            ]
                                        }
                                    },
                                    "type": {
                                        "type": "integer",
                                        "title": "推荐分类",
                                        "ui:widget": "select",
                                        "default": "10",
                                        "ui:options": {
                                            "hidden": "rootValue.source !== '1'",
                                            "options": [
                                                {
                                                    "value": "10",
                                                    "label": "全部"
                                                },
                                                {
                                                    "value": "200",
                                                    "label": "专题"
                                                },
                                                {
                                                    "value": "21",
                                                    "label": "产品"
                                                },
                                                {
                                                    "value": "22",
                                                    "label": "解决方案"
                                                },
                                                {
                                                    "value": "30",
                                                    "label": "帮助中心"
                                                },
                                                {
                                                    "value": "50",
                                                    "label": "云市场"
                                                },
                                                {
                                                    "value": "23",
                                                    "label": "开发者"
                                                },
                                                {
                                                    "value": "61",
                                                    "label": "博客"
                                                },
                                                {
                                                    "value": "65",
                                                    "label": "论坛"
                                                },
                                                {
                                                    "value": "63",
                                                    "label": "视频"
                                                },
                                                {
                                                    "value": "24",
                                                    "label": "云学院"
                                                },
                                                {
                                                    "value": "241",
                                                    "label": "基础课程"
                                                },
                                                {
                                                    "value": "242",
                                                    "label": "系列课程"
                                                },
                                                {
                                                    "value": "243",
                                                    "label": "认证"
                                                },
                                                {
                                                    "value": "244",
                                                    "label": "试验"
                                                },
                                                {
                                                    "value": "25",
                                                    "label": "知识"
                                                },
                                                {
                                                    "value": "20",
                                                    "label": "网站"
                                                },
                                                {
                                                    "value": "60",
                                                    "label": "云社区"
                                                }
                                            ]
                                        }
                                    },
                                    "guideType": {
                                        "type": "integer",
                                        "title": "推荐分类",
                                        "ui:widget": "select",
                                        "default": "1",
                                        "ui:options": {
                                            "hidden": "rootValue.source !== '3'",
                                            "options": [
                                                {
                                                    "value": "1",
                                                    "label": "文档"
                                                },
                                                {
                                                    "value": "2",
                                                    "label": "聚合关键词"
                                                },
                                                {
                                                    "value": "3",
                                                    "label": "标签"
                                                }
                                            ]
                                        }
                                    },
                                    "from": {
                                        "title": "取值开始位置",
                                        "type": "integer",
                                        "default": 1,
                                        "ui:options": {
                                            "hidden": "rootValue.source !== '3' || rootValue.guideType !== '1'",
                                            "controls": false
                                        }
                                    },
                                    "querySize": {
                                        "title": "取值数量",
                                        "type": "integer",
                                        "default": 100,
                                        "ui:widget": "number",
                                        "ui:options": {
                                            "hidden": "rootValue.source !== '3'  || rootValue.guideType !== '1'",
                                            "min": 1,
                                            "max": 100,
                                            "controls": false
                                        }
                                    },
                                    "sampleSize": {
                                        "title": "页面展示数量",
                                        "type": "integer",
                                        "default": 5,
                                        "ui:widget": "number",
                                        "ui:options": {
                                            "hidden": "rootValue.source !== '3'",
                                            "min": 1,
                                            "max": 100,
                                            "controls": false
                                        }
                                    },
                                    "nums": {
                                        "title": "选项个数",
                                        "description": "最多配置6个",
                                        "default": 1,
                                        "type": "integer",
                                        "ui:options": {
                                            "hidden": "rootValue.source === '3'",
                                            "min": 1,
                                            "max": 6,
                                            "controls": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}