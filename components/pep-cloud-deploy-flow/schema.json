{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Cloud Deploy Flow",
  "additionalProperties": false,
  "required": [
    "navbar",
    "sidebar",
    "mainContent",
    "iframePages"
  ],
  "properties": {
    "navbar": {
      "title": "顶部导航配置",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logo",
        "breadcrumbs",
        "rightActions"
      ],
      "properties": {
        "logo": {
          "title": "Logo 配置",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "img",
            "text"
          ],
          "properties": {
            "img": {
              "title": "Logo 图片地址",
              "type": "string",
              "ui:widget": "imageSelector"
            },
            "text": {
              "title": "Logo 文本",
              "type": "string"
            }
          }
        },
        "breadcrumbs": {
          "title": "面包屑",
          "type": "array",
          "default": [],
          "items": {
            "title": "面包屑项",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "title": "文案",
                "type": "string"
              },
              "url": {
                "title": "链接",
                "type": "string",
                "ui:options": { "format": "url" }
              }
            }
          }
        },
        "rightActions": {
          "title": "右侧操作",
          "type": "array",
          "default": [],
          "items": {
            "title": "右侧操作项",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "icon",
              "text"
            ],
            "properties": {
              "icon": {
                "title": "图标地址",
                "type": "string",
                "ui:widget": "imageSelector"
              },
              "text": {
                "title": "文案",
                "type": "string"
              },
              "url": {
                "title": "链接",
                "type": "string",
                "ui:options": { "format": "url" }
              }
            }
          }
        },
        "endDeployment": {
          "title": "结束部署配置",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buttonText",
            "modal",
            "successPage"
          ],
          "properties": {
            "buttonText": {
              "title": "按钮文案",
              "type": "string"
            },
            "icon": {
              "title": "按钮图标地址",
              "type": "string",
              "ui:widget": "imageSelector"
            },
            "modal": {
              "title": "结束部署弹窗",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "content",
                "confirmText"
              ],
              "properties": {
                "title": {
                  "title": "弹窗标题",
                  "type": "string"
                },
                "icon": {
                  "title": "提示图标地址",
                  "type": "string",
                  "ui:widget": "imageSelector"
                },
                "content": {
                  "title": "弹窗内容",
                  "type": "string"
                },
                "confirmText": {
                  "title": "确认按钮文案",
                  "type": "string"
                }
              }
            },
            "successPage": {
              "title": "结束部署成功页",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "items",
                "redeployText"
              ],
              "properties": {
                "title": {
                  "title": "结束页主标题",
                  "type": "string"
                },
                "description": {
                  "title": "结束页描述文案",
                  "type": "string"
                },
                "items": {
                  "title": "快捷入口卡片列表",
                  "type": "array",
                  "default": [],
                  "items": {
                    "title": "快捷入口项",
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["icon", "text", "url"],
                    "properties": {
                      "icon": {
                        "title": "图标地址",
                        "type": "string",
                        "ui:widget": "imageSelector"
                      },
                      "text": {
                        "title": "文案",
                        "type": "string"
                      },
                      "url": {
                        "title": "跳转链接",
                        "type": "string",
                        "ui:options": { "format": "url" }
                      }
                    }
                  }
                },
                "redeployText": {
                  "title": "重新部署按钮文案",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "sidebar": {
      "title": "侧边栏配置",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tabs",
        "footer",
        "texts"
      ],
      "properties": {
        "icons": {
          "title": "侧边栏右上角图标地址",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "floatIcon": { "title": "切换悬浮态图标", "type": "string", "ui:widget": "imageSelector" },
            "switchToSideModeIcon": { "title": "悬浮态切回侧边模式图标", "type": "string", "ui:widget": "imageSelector" },
            "minimizeToSideIcon": { "title": "全屏态切回侧边模式图标", "type": "string", "ui:widget": "imageSelector" },
            "fullscreenIcon": { "title": "切换全屏态图标", "type": "string", "ui:widget": "imageSelector" },
            "collapseIcon": { "title": "折叠侧边栏图标", "type": "string", "ui:widget": "imageSelector" },
            "stepCheckedIcon": { "title": "步骤条已完成状态图标", "type": "string", "ui:widget": "imageSelector" }
          }
        },
        "tabs": {
          "title": "标签页列表",
          "type": "array",
          "default": [],
          "items": {
            "title": "标签页项",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "title": "标签页标题",
                "type": "string"
              },
              "applications": {
                "title": "应用列表，每个应用对应一套 steps；未配置或为空时不展示下拉框",
                "type": "array",
                "default": [],
                "items": {
                  "title": "应用项",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "steps"],
                  "properties": {
                    "title": { "title": "应用名称", "type": "string" },
                    "steps": {
                      "title": "步骤列表",
                      "type": "array",
                      "default": [],
                      "items": {
                        "title": "步骤项",
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["title", "remoteContent"],
                        "properties": {
                          "title": { "title": "步骤标题", "type": "string" },
                          "remoteContent": {
                            "title": "远程内容配置",
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["source"],
                            "properties": {
                              "source": {
                                "title": "远程内容来源",
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["htmlUrl"],
                                "properties": {
                                  "htmlUrl": { "title": "远程 HTML 地址", "type": "string", "ui:options": { "format": "url" } },
                                  "cssUrl": { "title": "远程 CSS 地址", "type": "string", "ui:options": { "format": "url" } }
                                }
                              },
                              "preloaded": {
                                "title": "预加载内容",
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "html": { "title": "预加载 HTML", "type": "string" },
                                  "css": { "title": "预加载 CSS", "type": "string" }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "steps": {
                "title": "步骤列表，无 applications 时使用",
                "type": "array",
                "default": [],
                "items": {
                  "title": "步骤项",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "remoteContent"
                  ],
                  "properties": {
                    "title": {
                      "title": "步骤标题",
                      "type": "string"
                    },
                    "remoteContent": {
                      "title": "远程内容配置",
                      "type": "object",
                      "additionalProperties": false,
                    "required": [
                        "source"
                      ],
                      "properties": {
                        "source": {
                          "title": "远程内容来源",
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["htmlUrl"],
                          "properties": {
                            "htmlUrl": {
                              "title": "远程 HTML 地址",
                              "type": "string",
                              "ui:options": { "format": "url" }
                            },
                            "cssUrl": {
                              "title": "远程 CSS 地址",
                              "type": "string",
                              "ui:options": { "format": "url" }
                            }
                          }
                        },
                        "preloaded": {
                          "title": "预加载内容",
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "html": { "title": "预加载 HTML", "type": "string" },
                            "css": { "title": "预加载 CSS", "type": "string" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "footer": {
          "title": "底部翻页按钮文案",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prevText",
            "nextText"
          ],
          "properties": {
            "prevText": {
              "title": "上一步按钮文案",
              "type": "string"
            },
            "nextText": {
              "title": "下一步按钮文案",
              "type": "string"
            }
          }
        },
        "texts": {
          "title": "侧边栏文案配置",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openExternalDefaultTitle",
            "remoteLoadingText",
            "remoteLoadFailedText",
            "remoteFallbackMessageTemplate",
            "remoteFallbackLinkText"
          ],
          "properties": {
            "openExternalDefaultTitle": {
              "title": "链接缺失标题时的默认标题",
              "type": "string"
            },
            "remoteLoadingText": {
              "title": "远程内容加载中文案",
              "type": "string"
            },
            "remoteLoadFailedText": {
              "title": "远程内容加载失败文案",
              "type": "string"
            },
            "remoteFallbackMessageTemplate": {
              "title": "远程内容降级文案模板（支持 {tabLabel}/{stepId}/{stepLabel}）",
              "type": "string"
            },
            "remoteFallbackLinkText": {
              "title": "远程内容降级链接文案",
              "type": "string"
            }
          }
        }
      }
    },
    "mainContent": {
      "title": "主内容区配置",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "notice",
        "cloudProducts",
        "deploymentEstimate",
        "action",
        "agreement"
      ],
      "properties": {
        "title": {
          "title": "主标题",
          "type": "string"
        },
        "notice": {
          "title": "部署须知",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "contentHtml"
          ],
          "properties": {
            "title": {
              "title": "须知标题",
              "type": "string"
            },
            "contentHtml": {
              "title": "须知富文本内容",
              "type": "string"
            }
          }
        },
        "cloudProducts": {
          "title": "云产品资源区",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "products"
          ],
          "properties": {
            "title": {
              "title": "云产品区标题",
              "type": "string"
            },
            "products": {
              "title": "云产品列表",
              "type": "array",
              "default": [],
              "items": {
                "title": "云产品项",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "icon",
                  "text",
                  "url"
                ],
                "properties": {
                  "icon": {
                    "title": "云产品图标",
                    "type": "string",
                    "ui:widget": "imageSelector"
                  },
                  "text": {
                    "title": "云产品名称",
                    "type": "string"
                  },
                  "url": {
                    "title": "云产品链接",
                    "type": "string",
                    "ui:options": { "format": "url" }
                  }
                }
              }
            }
          }
        },
        "deploymentEstimate": {
          "title": "部署预估信息",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price",
            "priceNote",
            "duration",
            "durationLabel"
          ],
          "properties": {
            "price": {
              "title": "预估价格",
              "type": "string"
            },
            "priceNote": {
              "title": "价格说明",
              "type": "string"
            },
            "duration": {
              "title": "部署时长",
              "type": "string"
            },
            "durationLabel": {
              "title": "部署时长标签",
              "type": "string"
            }
          }
        },
        "action": {
          "title": "部署动作区",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buttonText",
            "url",
            "launchTitle"
          ],
          "properties": {
            "buttonText": {
              "title": "部署按钮文案",
              "type": "string"
            },
            "url": {
              "title": "部署跳转链接",
              "type": "string",
              "ui:options": { "format": "url" }
            },
            "launchTitle": {
              "title": "部署启动后页签标题",
              "type": "string"
            }
          }
        },
        "agreement": {
          "title": "协议确认",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contentHtml"
          ],
          "properties": {
            "contentHtml": {
              "title": "协议文案",
              "type": "string"
            }
          }
        }
      }
    },
    "backgroundImage": {
      "title": "全局背景图片地址，应用于部署引导页、实操结束页和伪浏览器空白页",
      "type": "string",
      "ui:widget": "imageSelector"
    },
    "iframePages": {
      "title": "伪浏览器与新建页配置",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "newTabPage"
      ],
      "properties": {
        "domainWhitelistPatterns": {
          "title": "伪浏览器域名白名单（pattern 列表）",
          "type": "array",
          "items": {
            "title": "白名单匹配项",
            "type": "string"
          }
        },
        "icons": {
          "title": "伪浏览器图标资源",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headerLogo": { "title": "地址栏前缀图标地址", "type": "string", "ui:widget": "imageSelector" },
            "addTab": { "title": "新建页签图标", "type": "string", "ui:widget": "imageSelector" },
            "collapse": { "title": "折叠左侧面板图标", "type": "string", "ui:widget": "imageSelector" },
            "fullscreen": { "title": "全屏伪浏览器图标", "type": "string", "ui:widget": "imageSelector" },
            "closeTab": { "title": "页签关闭图标", "type": "string", "ui:widget": "imageSelector" },
            "switchToSideIcon": { "title": "全屏时切回侧边模式图标", "type": "string", "ui:widget": "imageSelector" }
          }
        },
        "newTabPage": {
          "title": "新建页配置",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tabTitle",
            "title",
            "addressPlaceholder",
            "shortcuts"
          ],
          "properties": {
            "tabTitle": { "title": "新标签页页签标题", "type": "string" },
            "title": {
              "title": "新建页主标题",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "icon": { "title": "主标题图标地址", "type": "string", "ui:widget": "imageSelector" },
                "text": { "title": "主标题文案", "type": "string" }
              }
            },
            "addressPlaceholder": {
              "title": "新建标签页地址栏 placeholder 文案",
              "type": "string"
            },
            "shortcuts": {
              "title": "快捷入口配置",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "items"
              ],
              "properties": {
                "title": { "title": "快捷入口区域标题", "type": "string" },
                "items": {
                  "title": "快捷入口列表",
                  "type": "array",
                  "default": [],
                  "items": {
                    "title": "快捷入口项",
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["icon", "text", "url"],
                    "properties": {
                      "icon": { "title": "快捷入口图标地址", "type": "string", "ui:widget": "imageSelector" },
                      "text": { "title": "快捷入口名称", "type": "string" },
                      "url": {
                        "title": "快捷入口跳转链接",
                        "type": "string",
                        "ui:options": { "format": "url" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "commonConfig": {
      "title": "组件公共配置",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icons": {
          "title": "折叠态恢复图标",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sidebarMinimizeIcon": {
              "title": "侧边栏折叠后恢复图标（左侧）",
              "type": "string",
              "ui:widget": "imageSelector"
            },
            "browserMinimizeIcon": {
              "title": "伪浏览器折叠后恢复图标（右侧）",
              "type": "string",
              "ui:widget": "imageSelector"
            }
          }
        }
      }
    }
  }
}
