          "param_type": "string",
          "location": "body",
          "required": true,
          "default": null,
          "description": "需要执行的 ADB 命令，只支持大小写字母、数字、下划线（_）、点（.）、斜线（/）、冒号（:）、中划线（-）。",
          "enum_values": null,
          "example": "\"ls -l /system\"",
          "constraints": [
            "Maximum length: 1024"
          ],
          "list_items": [],
          "content": []
        },
        {
          "type": "api-param",
          "name": "instance_ids",
          "param_type": "array[string]",
          "location": "body",
          "required": true,
          "default": null,
          "description": "需要执行命令的实例 ID 列表，单个实例 ID 最长 32 个字符。",
          "enum_values": null,
          "example": "[\"a44uhlf7\", \"efjy72gs\"]",
          "constraints": [
            "Maximum array length: 100",
            "Item maximum length: 32"
          ],
          "list_items": [],
          "content": []
        }
