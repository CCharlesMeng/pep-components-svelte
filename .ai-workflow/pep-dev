def run_command(command: str, args: list):
    """执行命令"""
    if command not in COMMANDS:
        print(f"❌ 未知命令: {command}")
        print(f"运行 'pep-dev help' 查看可用命令")
        sys.exit(1)
    
    cmd_info = COMMANDS[command]
    script_path = SCRIPT_DIR / cmd_info["script"]
    
    if not script_path.exists():
        print(f"❌ 脚本不存在: {script_path}")
        sys.exit(1)
    
    # 转换参数格式
    script_args = []
    
    # 使用位置参数的命令（新脚本）
    positional_commands = ["spec", "check"]
    
    if command == "summary":
        # summary 不需要 component 参数
        script_args = args
    elif command == "done":
        # done <component> <id> [options]
        if len(args) >= 2:
            script_args = ["--component", args[0], "--feature-id", args[1]] + args[2:]
        else:
            script_args = args
    elif command in positional_commands:
        # 新脚本使用位置参数: <command> <component> [options]
        script_args = args
    else:
        # 旧脚本使用 --component: <command> <component> [options]
        if len(args) >= 1 and not args[0].startswith("-"):
            script_args = ["--component", args[0]] + args[1:]
        else:
            script_args = args
    
    # 构建完整命令
    full_cmd = [sys.executable, str(script_path)] + script_args
    
    # 执行脚本
    try:
        result = subprocess.run(full_cmd, check=False)
        sys.exit(result.returncode)
    except KeyboardInterrupt:
        print("\n⚠️  命令被中断")
        sys.exit(130)
    except Exception as e:
        print(f"❌ 执行失败: {e}")
        sys.exit(1)

def main():
    """主函数"""
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help", "help"]:
        show_help()
        sys.exit(0)
    
    command = sys.argv[1]
    args = sys.argv[2:]
    
    run_command(command, args)

if __name__ == "__main__":
    main()

